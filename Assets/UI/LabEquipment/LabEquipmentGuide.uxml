<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/LabEquipment/LabEquipmentGuide.uss?fileID=7433441132597879392&amp;guid=189b5a94eb17405dbe1044da271e970f&amp;type=3#LabEquipmentGuide" />
    <ui:VisualElement name="equipment-screen" class="equipment-screen">
        <ui:VisualElement class="header">
            <ui:Label text="Before You Begin" style="width: 583px; height: 62px; color: rgb(238, 255, 242); font-size: 60px; -unity-text-align: middle-center; -unity-font-style: bold;" />
        </ui:VisualElement>
        <ui:VisualElement name="learning-view" class="learning-view hidden">
            <ui:VisualElement class="image-row">
                <ui:Button name="previous-equipment" text="&lt;" tooltip="Previous equipment" class="arrow" />
                <ui:Image name="equipment-image" class="equipment-image" />
                <ui:Button name="next-equipment" text="&gt;" tooltip="Next equipment" class="arrow" />
            </ui:VisualElement>
            <ui:Label name="equipment-function" text="Explore each piece of equipment and learn what it does." class="function" />
            <ui:VisualElement class="name-bar">
                <ui:Label name="equipment-title" text="Pipette" class="equipment-name" />
            </ui:VisualElement>
            <ui:Label name="slide-position" text="1 / 5" class="page-count" />
        </ui:VisualElement>
        <ui:VisualElement name="completion-view" class="completion-view hidden">
            <ui:Label text="Learning complete" class="completion-title" />
            <ui:Label text="You have explored the equipment and its functions." class="completion-copy" />
            <ui:Label text="Review the equipment again or continue to PCR plate setup." class="completion-copy" />
            <ui:VisualElement class="completion-actions">
                <ui:Button name="retake-learning" text="Retake learning" class="action secondary" />
                <ui:Button name="proceed-next-step" text="Proceed to next step" class="action primary" />
            </ui:VisualElement>
            <ui:Label name="navigation-status" class="navigation-status" />
        </ui:VisualElement>
        <ui:VisualElement name="overview-view" class="completion-view">
            <ui:Label class="completion-title" />
            <ui:Label text="Welcome to TWAG Hospital, Ede, Osun State!&#10;&#10;50 patient samples have been collected for an HIV research study, but today, you’ll be working with just 5 sample.&#10;&#10;Your mission as a laboratory scientist is to prepare a PCR plate for testing. Follow each step carefully, handle the samples correctly, and get everything ready for the next stage.&#10;&#10;Ready to begin? Let’s explore the equipment you’ll need!" class="completion-copy" style="-unity-text-outline-color: rgb(88, 88, 88); color: rgb(2, 18, 3); -unity-text-align: lower-left; -unity-font-style: normal;" />
            <ui:VisualElement class="completion-actions">
                <ui:Button name="continue-to-equipment" text="Explore the equipments" class="action primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
