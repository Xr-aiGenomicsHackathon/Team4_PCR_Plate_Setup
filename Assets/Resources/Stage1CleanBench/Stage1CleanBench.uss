.screen { flex-grow:1; justify-content:center; align-items:center; background-color:rgba(0,0,0,0); padding:28px; }
.panel { width:1120px; padding:36px 42px 30px; background-color:#F7FAF8; border-width:2px; border-color:#D8E4DE; border-radius:28px; }
.topline { flex-direction:row; align-items:center; }
.brand-mark { width:56px; height:56px; margin-right:18px; justify-content:center; align-items:center; background-color:#DDF3E9; border-width:1px; border-color:#C6E9D7; border-radius:18px; }
.brand-mark Label { color:#16856C; font-size:17px; -unity-font-style:bold; }
.heading-copy { justify-content:center; }
.eyebrow { color:#16856C; font-size:13px; -unity-font-style:bold; letter-spacing:1.5px; }
.title { color:#18352D; font-size:34px; -unity-font-style:bold; margin-top:4px; }
.spacer { flex-grow:1; }
.stage-pill { padding:10px 15px; background-color:#E8F3ED; border-width:1px; border-color:#D3E6DA; border-radius:14px; }
.stage-pill Label { color:#376652; font-size:13px; -unity-font-style:bold; letter-spacing:.6px; }
.summary { color:#687B73; font-size:17px; margin-top:15px; margin-bottom:24px; }
.progress-row { flex-direction:row; justify-content:space-between; align-items:center; margin-bottom:12px; }
.section-label { color:#72847D; font-size:12px; -unity-font-style:bold; letter-spacing:1.1px; }
.state-pill { padding:7px 11px; color:#896323; font-size:11px; -unity-font-style:bold; background-color:#F8F1DE; border-radius:10px; }
.checklist { padding:5px 20px; background-color:#FFFFFF; border-width:1px; border-color:#E0E9E4; border-radius:18px; }
.item-row { min-height:73px; flex-direction:row; align-items:center; border-bottom-width:1px; border-bottom-color:#EDF1EE; }
.item-icon { width:38px; height:38px; margin-right:16px; align-items:center; justify-content:center; background-color:#F0F5F2; border-radius:12px; }
.item-icon Label { color:#84938D; font-size:12px; -unity-font-style:bold; }
.item-copy { justify-content:center; }
.item-tag { color:#8A9992; font-size:10px; -unity-font-style:bold; letter-spacing:1px; margin-bottom:3px; }
.item-title { color:#435B50; font-size:17px; }
.item-row.done .item-icon { background-color:#DDF3E9; }
.item-row.done .item-icon Label { color:#16856C; }
.item-row.done .item-title { color:#16856C; -unity-font-style:bold; }
.feedback-card { min-height:84px; flex-direction:row; align-items:center; padding:16px 18px; margin-top:16px; background-color:#F5F7F1; border-width:1px; border-color:#E8E9DB; border-radius:15px; }
.feedback-dot { width:10px; height:10px; flex-shrink:0; margin-right:14px; background-color:#D99A36; border-radius:8px; }
.feedback-copy { flex-grow:1; }
.feedback-title { color:#35483E; font-size:15px; -unity-font-style:bold; }
.feedback-detail { color:#758179; font-size:12px; white-space:normal; margin-top:5px; }
.feedback-card.warning { background-color:#FBF2E8; border-color:#EED9C5; }
.feedback-card.warning .feedback-dot { background-color:#C77A42; }
.feedback-card.complete { background-color:#EDF7F1; border-color:#CFE7D9; }
.feedback-card.complete .feedback-dot { background-color:#26966E; }
.footer { flex-direction:row; align-items:center; margin-top:20px; padding-top:18px; border-top-width:1px; border-top-color:#E2EAE6; }
.score-label { color:#708078; font-size:11px; -unity-font-style:bold; letter-spacing:.8px; }
.next { height:48px; padding:0 20px; color:#FFF; font-size:14px; -unity-font-style:bold; background-color:#16856C; border-width:0; border-radius:13px; }
.next:hover { background-color:#116E59; }
.next:disabled { color:#89968F; background-color:#E8EDE9; }